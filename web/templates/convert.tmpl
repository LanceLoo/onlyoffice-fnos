<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>格式转换 - {{.FileName}}</title>
    <link rel="stylesheet" href="/static/bulma.min.css">
    <script src="/static/htmx.min.js"></script>
    <style>
        .modal { display: none; }
        .modal.is-active { display: flex; }
        .modal-actions { flex-wrap: wrap; gap: 0.75rem; }
        .modal-actions .button { flex: 1 1 auto; margin: 0; white-space: normal; height: auto; min-width: 120px; }
        @media screen and (max-width: 480px) {
            .modal-actions { flex-direction: column; }
            .modal-actions .button { width: 100%; }
        }
        .convert-advanced { text-align: left; }
        .convert-advanced summary { cursor: pointer; color: #7a7a7a; font-size: 0.875rem; list-style-position: inside; }
        .convert-advanced summary:hover { color: #363636; }
        .convert-advanced[open] summary { margin-bottom: 0.75rem; }
    </style>
</head>
<body>
    <section class="hero is-fullheight has-background-light">
        <div class="hero-body">
            <div class="container">
                <div class="columns is-centered">
                    <div class="column is-half-desktop is-two-thirds-tablet">
                        <div class="box">
                            <h1 class="title is-5 has-text-centered">文档格式转换</h1>

                            <div id="error">
                                {{if .Error}}
                                <div class="notification is-danger">{{.Error}}</div>
                                {{end}}
                            </div>

                            <div class="has-text-centered mb-4">
                                <p class="is-size-5 has-text-weight-medium mb-2">{{.FileName}}</p>
                                <div>
                                    <span class="tag is-info is-medium">{{.SourceFormat}}</span>
                                    <span class="mx-2">→</span>
                                    <span class="tag is-success is-medium">{{.TargetFormat}}</span>
                                </div>
                            </div>

                            <p class="has-text-grey has-text-centered mb-5">该文件格式 ({{.SourceFormat}}) 不支持直接编辑。您可以选择以下操作：</p>

                            <form hx-post="/convert" hx-target="#error" hx-swap="innerHTML">
                                <input type="hidden" name="path" value="{{.FilePath}}">
                                {{if .IsCSV}}
                                <details class="convert-advanced mb-3">
                                    <summary>转换设置（编码与分隔符 · 默认 UTF-8 / 逗号）</summary>
                                    <div class="columns is-mobile is-variable is-2 mb-0">
                                        <div class="column">
                                            <div class="field">
                                                <label class="label is-small" for="codePage">编码</label>
                                                <div class="control">
                                                    <div class="select is-fullwidth">
                                                        <select id="codePage" name="codePage">
                                                            <option value="65001" selected>UTF-8（推荐）</option>
                                                            <option value="936">简体中文 GBK / GB2312</option>
                                                            <option value="950">繁体中文 Big5</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="column">
                                            <div class="field">
                                                <label class="label is-small" for="delimiter">分隔符</label>
                                                <div class="control">
                                                    <div class="select is-fullwidth">
                                                        <select id="delimiter" name="delimiter">
                                                            <option value="4" selected>逗号 (,)</option>
                                                            <option value="1">Tab</option>
                                                            <option value="2">分号 (;)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                                {{end}}
                                {{if .IsTXT}}
                                <details class="convert-advanced mb-3">
                                    <summary>转换设置（编码 · 默认 UTF-8）</summary>
                                    <div class="field">
                                        <label class="label is-small" for="codePage">编码</label>
                                        <div class="control">
                                            <div class="select is-fullwidth">
                                                <select id="codePage" name="codePage">
                                                    <option value="65001" selected>UTF-8（推荐）</option>
                                                    <option value="936">简体中文 GBK / GB2312</option>
                                                    <option value="950">繁体中文 Big5</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                                {{end}}
                                <button type="submit" class="button is-primary is-fullwidth is-medium mb-3">转换为 {{.TargetFormat}} 并编辑</button>
                            </form>
                            <a href="/editor?path={{.FilePath}}&mode=view" class="button is-light is-fullwidth is-medium">以只读模式查看</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Conflict resolution / compatibility confirmation modal -->
    <div class="modal" id="conflict-modal">
        <div class="modal-background" onclick="cancelModal()"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title" id="modal-title">目标文件已存在</p>
                <button class="delete" aria-label="close" onclick="cancelModal()"></button>
            </header>
            <section class="modal-card-body">
                <p id="modal-message">目标文件已存在，请选择操作：</p>
            </section>
            <footer class="modal-card-foot modal-actions" id="modal-actions">
                <button class="button" onclick="cancelModal()">取消</button>
                <button class="button is-warning" onclick="submitOverwrite()">覆盖</button>
                <button class="button is-success" onclick="submitAutoRename()">生成带后缀文件</button>
            </footer>
        </div>
    </div>

    <script>
        let currentSourcePath = '';
        let compatConfirmed = false;
        let pendingConflictPolicy = 'default'; // 'default' | 'autoRename' | 'overwrite'

        function resetCompatState() {
            compatConfirmed = false;
            pendingConflictPolicy = 'default';
        }

        function getSourcePath(resp) {
            if (resp && resp.sourcePath) return resp.sourcePath;
            const input = document.querySelector('input[name="path"]');
            return input ? input.value : '';
        }

        // Text conversion selectors only exist on CSV/TXT conversion pages.
        // CSV has codePage + delimiter; TXT has codePage only.
        function textConversionParams() {
            const params = {};
            const codePage = document.getElementById('codePage');
            if (codePage) params.codePage = codePage.value;
            const delimiter = document.getElementById('delimiter');
            if (delimiter) params.delimiter = delimiter.value;
            return params;
        }

        document.querySelector('form[hx-post="/convert"]').addEventListener('submit', resetCompatState);

        document.body.addEventListener('htmx:afterRequest', function(evt) {
            if (evt.detail.successful) {
                resetCompatState();
            }
        });

        document.body.addEventListener('htmx:responseError', function(evt) {
            let resp;
            try {
                resp = JSON.parse(evt.detail.xhr.responseText);
            } catch (e) {
                return;
            }
            if (!resp) return;

            // Compatibility mode confirmation takes precedence over a normal conflict.
            if (resp.reason === 'atomic_no_replace_unsupported') {
                currentSourcePath = getSourcePath(resp);
                openCompatibilityModal();
                document.getElementById('error').innerHTML = '';
                evt.preventDefault();
            } else if (resp.conflict) {
                currentSourcePath = getSourcePath(resp);
                openConflictModal(resp.targetPath || '');
                document.getElementById('error').innerHTML = '';
                evt.preventDefault();
            }
        });

        function closeConflictModal() {
            document.getElementById('conflict-modal').classList.remove('is-active');
        }

        function cancelModal() {
            resetCompatState();
            closeConflictModal();
        }

        function openConflictModal(targetPath) {
            document.getElementById('modal-title').textContent = '目标文件已存在';
            document.getElementById('modal-message').textContent =
                (targetPath ? '"' + targetPath + '" ' : '') + '已存在，请选择操作：';
            document.getElementById('modal-actions').innerHTML =
                '<button class="button" onclick="cancelModal()">取消</button>' +
                '<button class="button is-warning" onclick="submitOverwrite()">覆盖</button>' +
                '<button class="button is-success" onclick="submitAutoRename()">生成带后缀文件</button>';
            document.getElementById('conflict-modal').classList.add('is-active');
        }

        function openCompatibilityModal() {
            document.getElementById('modal-title').textContent = '需要确认兼容模式';
            document.getElementById('modal-message').innerHTML =
                '当前系统无法使用原子无替换保存。继续将以兼容模式保存转换后的文件，' +
                '该模式无法保证：如果转换过程中有其他用户创建了同名文件，可能会造成冲突或覆盖。<br><br>' +
                '是否继续使用兼容模式？';
            document.getElementById('modal-actions').innerHTML =
                '<button class="button" onclick="cancelModal()">取消</button>' +
                '<button class="button is-primary" onclick="submitCompatibilityMode()">继续使用兼容模式</button>';
            document.getElementById('conflict-modal').classList.add('is-active');
        }

        function submitOverwrite() {
            pendingConflictPolicy = 'overwrite';
            closeConflictModal();
            htmx.ajax('POST', '/convert?overwrite=true', {
                target: '#error',
                swap: 'innerHTML',
                values: Object.assign({ path: currentSourcePath }, textConversionParams())
            });
        }

        function submitAutoRename() {
            pendingConflictPolicy = 'autoRename';
            closeConflictModal();
            const params = compatConfirmed ? '?auto_rename=true&allow_unsafe_save=true' : '?auto_rename=true';
            htmx.ajax('POST', '/convert' + params, {
                target: '#error',
                swap: 'innerHTML',
                values: Object.assign({ path: currentSourcePath }, textConversionParams())
            });
        }

        function submitCompatibilityMode() {
            compatConfirmed = true;
            closeConflictModal();

            // Retry the last user conflict choice, falling back to a plain compat confirmation.
            let params;
            if (pendingConflictPolicy === 'autoRename') {
                params = '?auto_rename=true&allow_unsafe_save=true';
            } else if (pendingConflictPolicy === 'overwrite') {
                params = '?overwrite=true';
            } else {
                params = '?allow_unsafe_save=true';
            }

            htmx.ajax('POST', '/convert' + params, {
                target: '#error',
                swap: 'innerHTML',
                values: Object.assign({ path: currentSourcePath }, textConversionParams())
            });
        }
    </script>
</body>
</html>
